
pipeline {
    agent any

    stages {
        stage('test') {
            steps {
                script {
                    echo 'Testing the application...'
                    echo "executing pipeline for branch $BRANCH_NAME"
                }
            }
        }
        stage('build') {
            when {
                expression {
                    BRANCH_NAME == 'main'
                }
            }
            steps {
                script {
                    echo 'Building the application...'
                }
            }
        }
        stage('Deploy') {
            when {
                expression {
                    BRANCH_NAME == 'main'
                }
            }
            steps {
                script {
                    'Deploying application...'
                }
            }
        }
    }
}
